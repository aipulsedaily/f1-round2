+def picture_fragments():
+    """THE FRAGMENTS THE DELIVERED FRAMES CONTAIN, READ RATHER THAN INVENTED.
+
+    `sim/fracture.py` partitions every pane -- radials first, then hoops
+    arrested on them, then a mosaic coarsening outward, with the 16 mm clamped
+    under the pressure plate holding SLABS -- and publishes one record per shard
+    in `sim/out/breach_sim.json`, which is TRACKED and is the partition the 4K
+    frames were rendered from. Until R2-4151 the audio had never read it and
+    drew its own size law instead:
+
+        equivalent side       the picture      the audio, as delivered
+        under 20 mm                  1412                            0
+        20-50 mm                     1108                            2
+        over 400 mm                    28                          132
+        median piece                21 mm                       321 mm
+        count / mass          3216 / 1119 kg              351 / 1624 kg
+
+    An order of magnitude out in count and in size, IN BOTH DIRECTIONS AT ONCE.
+    Correcting it is worth 0.017 of articulation on the layer and -0.0003 in the
+    mix -- the population was never the defect, the damping was (`shard_modes`)
+    -- and it ships anyway because it is a picture desync and because it takes
+    the shard bus from 0.15 % of its energy above 4 kHz to 6.46 %, i.e. 43x.
+
+    Which bays come down is the picture's answer too: `fracture_wall.json`'s
+    `breach_state` marks the destroyed bays, and of the 3016 shards in them
+    2936 displace more than 0.5 m in the delivered bake while the other four
+    bays contribute 24 pieces between them -- so the bay test is the picture's
+    own answer to "which glass comes down", to 97 %.
+
+    Returns (L_m, mass_kg, origin_xyz, clamped).
+    """
+    if "frags" in _PICTURE_FRAGMENT_CACHE:
+        return _PICTURE_FRAGMENT_CACHE["frags"]
+    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    with open(os.path.join(root, "sim", "out", "fracture_wall.json")) as fh:
+        wall = json.load(fh)
+    gone = {b["uid"] for b in wall["breach_state"] if b["beat3"] == "destroyed"}
+    with open(os.path.join(root, "sim", "out", "breach_sim.json")) as fh:
+        meta = json.load(fh)["shard_meta"]
+    keep = sorted((m for m in meta if m["bay"] in gone), key=lambda m: m["name"])
+    out = (np.sqrt(np.array([m["area"] for m in keep], dtype=np.float64)),
+           np.array([m["mass"] for m in keep], dtype=np.float64),
+           np.array([m["origin"] for m in keep], dtype=np.float64),
+           np.array([bool(m["clamped"]) for m in keep]))
+    _PICTURE_FRAGMENT_CACHE["frags"] = out
+    return out
